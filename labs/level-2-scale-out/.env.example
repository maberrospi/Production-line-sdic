# Ports on your machine. Change them if 8080 or 8404 are already in use
# (check with: lsof -i :8080   on macOS/Linux, or   netstat -ano | findstr :8080   on Windows).
LB_PORT=8080
STATS_PORT=8404

# Where sessions live: memory (step 3) or redis (step 4)
SESSION_STORE=memory

# HAProxy balancing algorithm: roundrobin (default), leastconn (step 6), random
BALANCE=roundrobin
