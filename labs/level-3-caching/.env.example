# Port on your machine for the edge (nginx). Change it if 8080 is in use
# (check with: lsof -i :8080   on macOS/Linux, or   netstat -ano | findstr :8080   on Windows).
EDGE_PORT=8080

# How long a cached product lives in Redis, in seconds (steps 2-3)
CACHE_TTL=60

# Stampede protection for /hot: none or lock (step 4)
STAMPEDE_PROTECTION=none
