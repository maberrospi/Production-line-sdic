# Port on your machine for the API. If 8000 is already in use, pick another (8001, 18000...).
# Check what is using a port:  macOS/Linux: lsof -i :8000   Windows: netstat -ano | findstr :8000
API_PORT=8000

# Number of uvicorn worker processes (step 6: try 4)
WORKERS=1
# CPU cores the API container may use
API_CPUS=4
