# Copy to .env and never commit it. On the VM: chmod 600 .env

DOMAIN=localhost

# Ports on your machine for nginx. On a server keep 80/443 (Let's Encrypt needs 80).
# Locally, if they are taken (another web server, another project): HTTP_PORT=8080, HTTPS_PORT=8443
# and open https://localhost:8443 instead of https://localhost
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=app

# Image to run. Locally: app-api (built with docker build). In CI: ghcr.io/<you>/app-api
API_IMAGE=app-api
# Managed by scripts/deploy.sh: the tag currently live
API_TAG=v1

# Where backups are copied. Examples:
#   gs://my-backups-bucket/app      (needs gcloud CLI)
#   s3://my-backups-bucket/app      (needs aws CLI)
#   /mnt/other-disk/backups         (a local path, for the lab)
BACKUP_REMOTE=./offsite

# Optional: Healthchecks.io / Better Stack heartbeat URL pinged after each successful backup
HEARTBEAT_URL=
